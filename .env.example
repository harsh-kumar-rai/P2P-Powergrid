# Turso (libsql) — create at https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# JWT secret for authentication (REQUIRED in production)
JWT_SECRET=change-this-to-a-strong-secret

# Google Gemini API key for AI insights (optional)
GEMINI_API_KEY=your-gemini-api-key

# Blockchain deployment (optional — only for deploying contracts to Sepolia)
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
# DEPLOYER_PRIVATE_KEY=your-deployer-private-key
